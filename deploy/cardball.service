[Unit]
Description=Cardball game server
After=network.target postgresql.service

[Service]
Type=simple
User=cardball
Group=cardball
WorkingDirectory=/opt/cardball/app
EnvironmentFile=/opt/cardball/.env
ExecStart=/usr/bin/env pnpm --filter @cardball/server start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
